{
   "name": "Always Show Game Labels",
   "author": "nkay08",
   "version": "v1.0",
   "description": "Always show the game title under the capsule in the Steam Deck / Big Picture Mode library and home screens.",
   "manifest_version": 9,
   "tabs": {
      "default": [
         "bigpicture"
      ]
   },
   "inject": {
      "shared.css": []
   },
   "patches": {
      "Library": {
         "type": "checkbox",
         "default": "Yes",
         "values": {
            "Yes": {
               "library.css": [
                  "bigpicture"
               ]
            },
            "No": {}
         }
      },
      "Carousel": {
         "type": "checkbox",
         "default": "Yes",
         "values": {
            "Yes": {
               "carousel.css": [
                  "bigpicture"
               ]
            },
            "No": {}
         }
      },
      "Font size (em)": {
         "type": "slider",
         "default": "5",
         "values": {
            "1": {
               "--asgl-font-size": [
                  "0.50em"
               ]
            },
            "2": {
               "--asgl-font-size": [
                  "0.55em"
               ]
            },
            "3": {
               "--asgl-font-size": [
                  "0.60em"
               ]
            },
            "4": {
               "--asgl-font-size": [
                  "0.65em"
               ]
            },
            "5": {
               "--asgl-font-size": [
                  "0.7em"
               ]
            },
            "6": {
               "--asgl-font-size": [
                  "0.75em"
               ]
            },
            "7": {
               "--asgl-font-size": [
                  "0.8em"
               ]
            },
            "8": {
               "--asgl-font-size": [
                  "0.85em"
               ]
            },
            "9": {
               "--asgl-font-size": [
                  "0.9em"
               ]
            },
            "10": {
               "--asgl-font-size": [
                  "0.95em"
               ]
            },
            "11": {
               "--asgl-font-size": [
                  "1em"
               ]
            }
         }
      }
   }
}
